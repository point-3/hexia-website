# Directus API 基础地址
# 必填：是；默认值：无。
# 用途：仅供 Next.js 服务端/API Route 访问 Directus，浏览器端通过 /api/cms/* 同源代理读取 CMS 数据。
# 本地开发通常为 http://127.0.0.1:8055；Vercel 部署可填写 http://服务器公网IP:8055。
# 生产：https://dashboard.hexiabio.com
DIRECTUS_URL=http://127.0.0.1:8055
CMS_REVALIDATE_SECRET=change-me
CMS_REVALIDATE_SECONDS=60
